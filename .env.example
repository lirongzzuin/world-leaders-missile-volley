# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Anon key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key (server-only — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# REST URL from Upstash console
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX4...

# ── NextAuth.js ───────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-here
NEXTAUTH_URL=http://localhost:3000

# ── Kakao OAuth ───────────────────────────────────────────────────────────────
# From Kakao Developers → My App → App Keys
KAKAO_CLIENT_ID=your-kakao-rest-api-key
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# ── Google OAuth ──────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ── Toss Apps-in-Toss OAuth ───────────────────────────────────────────────────
# From Toss Developer Portal → App Settings
TOSS_CLIENT_ID=your-toss-client-id
TOSS_CLIENT_SECRET=your-toss-client-secret
TOSS_REDIRECT_URI=https://your-domain.com/api/toss-callback

# ── Socket.io server (Fly.io) ─────────────────────────────────────────────────
# URL of the deployed socket server on Fly.io
NEXT_PUBLIC_SOCKET_SERVER_URL=https://wlmv-server.fly.dev
# Secret shared between Fly.io socket server and Next.js API routes (server-to-server)
SERVER_SECRET=generate-a-random-secret-here
# Origin of the Next.js app (set this on Fly.io as CLIENT_ORIGIN)
CLIENT_ORIGIN=https://your-app.vercel.app
# Vercel Cron secret (set as CRON_SECRET on Vercel)
CRON_SECRET=generate-another-random-secret

# ── Kakao AdFit ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADFIT_LOBBY_UNIT_ID=DAN-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADFIT_LOADING_UNIT_ID=DAN-xxxxxxxxxxxxxxxx

# ── Google AdSense ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SET_UNIT_ID=xxxxxxxxxx
NEXT_PUBLIC_ADSENSE_RESULT_UNIT_ID=xxxxxxxxxx
